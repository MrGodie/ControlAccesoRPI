<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The app only talks to the Raspberry Pi over the local network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        usesCleartextTraffic: the Raspberry Pi API is plain HTTP on the
        local network, and Android blocks plain HTTP by default.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ControlAcceso"
        android:usesCleartextTraffic="true" />

</manifest>
