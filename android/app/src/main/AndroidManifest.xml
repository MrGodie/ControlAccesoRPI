<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The app only talks to the Raspberry Pi over the local network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Facial access (FR-22). Without a camera the app still works with code and key. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--
        usesCleartextTraffic: the Raspberry Pi API is plain HTTP on the
        local network, and Android blocks plain HTTP by default.
    -->
    <application
        android:name=".AccessApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ControlAcceso"
        android:usesCleartextTraffic="true">

        <!-- View 0: facial access with the front camera. The app opens here (FR-22). -->
        <activity
            android:name=".ui.FaceActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- View 1: identification with code and key, also the fallback when the face fails. -->
        <activity
            android:name=".ui.IdentificationActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- View 2: access request, enabled by presence. -->
        <activity
            android:name=".ui.RequestActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- View 3: result of the request. -->
        <activity
            android:name=".ui.ResultActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>

</manifest>
